<?xml version="1.0" encoding="utf-8"?>
<!-- Window background while the launcher activity starts: the same navy
     the splash screen itself is drawn on, so there is no flash before
     the artwork appears. The splash is drawn in ui/SplashScreen.kt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#13233F" android:endColor="#0A1222" />
</shape>
